# ============================================================
# Three direct upstreams (no gateway). The three key slots are independent;
# use the same provider value for all three if you only have one account.
# ============================================================

# --- chat ---
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-flash
CHAT_API_KEY=sk-xxx

# Explicit model context window (tokens). Empty = look up by model name (server/src/core/budget.ts).
# MODEL_CONTEXT_WINDOW=1000000

# Intent/summary slots default to the chat group; set these only to split providers.
# INTENT_MODEL=deepseek-flash
# INTENT_BASE_URL=https://api.deepseek.com
# INTENT_API_KEY=sk-xxx
# SUMMARY_MODEL=deepseek-flash
# SUMMARY_BASE_URL=https://api.deepseek.com
# SUMMARY_API_KEY=sk-xxx

# Thinking chain: adaptive (model decides) / disabled.
CHAT_THINKING=adaptive
# CHAT_REASONING_EFFORT=low
# MiniMax only: keep reasoning in the separate reasoning_content field.
CHAT_REASONING_SPLIT=true

# --- embeddings (qwen3.7-text-embedding-flash) ---
EMBED_MODEL=qwen3.7-text-embedding-flash
EMBED_API_KEY=sk-xxx
EMBED_BASE_URL=https://cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# --- rerank (qwen3.7-text-rerank) ---
RERANK_MODEL=qwen3.7-text-rerank
RERANK_API_KEY=sk-xxx
RERANK_BASE_URL=https://cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# --- storage ---
DATABASE_URL=postgresql://youruser@127.0.0.1:5432/yukino_agent2
# LangGraph checkpointer database; auto-created on first start.
CHECKPOINTER_DB_URL=postgresql://youruser@127.0.0.1:5432/yukino_agent2_checkpoints

# --- milvus standalone vector store (optional) ---
# Empty = legacy mode: dense retrieval runs in-process over relational embeddings and BM25 is
# computed in-process, so no extra service is needed.
# Set to the Milvus Standalone address to make Milvus the authoritative vector store: dense ANN,
# native BM25 full-text search and hybrid RRF fusion all run inside Milvus. Start Milvus with
# `node server/main.js milvus-up` (RPM/DEB systemd install, or the vendored docker compose file
# in server/deploy/milvus/). See server/src/kb/milvus.ts.
# MILVUS_URI=http://127.0.0.1:19530
# Auth token ("username:password" or API key) for a secured Milvus; empty by default.
# MILVUS_TOKEN=
# MILVUS_COLLECTION=knowledge

# --- tools / MCP ---
MCP_LOGISTICS_URL=http://127.0.0.1:8101/mcp
MCP_AFTERSALES_URL=http://127.0.0.1:8102/mcp
DEMO_TICKET_DELAY_SECONDS=0

# --- observability (all three set = Langfuse tracing enabled) ---
# LANGFUSE_PUBLIC_KEY=pk-lf-yukino-agent2-local
# LANGFUSE_SECRET_KEY=sk-lf-yukino-agent2-local
# LANGFUSE_BASE_URL=http://localhost:3000

# --- server ---
HOST=127.0.0.1
PORT=8000
