{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "description": "yukino-agent2 customer-service agent backend",
  "main": "src/index.ts",
  "imports": {
    "#/*": "./src/*",
    "#generated/*": "./generated/*",
    "#scripts/*": "./scripts/*",
    "#tests/*": "./tests/*"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:prod": "node dist/index.mjs",
    "build": "tsdown",
    "lint": "pnpm --dir ../ lint",
    "format": "pnpm --dir ../ format",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push"
  },
  "keywords": [
    "langchain",
    "langgraph"
  ],
  "author": "https://github.com/hangtiancheng",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.4.21",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.6",
    "@langchain/openai": "^1.6.2",
    "@langchain/textsplitters": "^1.0.2",
    "@langfuse/langchain": "^5.13.1",
    "@langfuse/otel": "^5.13.1",
    "@langfuse/tracing": "^5.13.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "^7.10.0",
    "@zilliz/milvus2-sdk-node": "^3.0.6",
    "ajv": "8.20.0",
    "hono": "^4.13.13",
    "hono-pino": "^0.10.3",
    "openai": "^7.32.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
